# Copier en .env.local et remplir avec les valeurs du projet Supabase
# (tableau de bord Supabase → Project Settings → API Keys).
# Seules ces deux valeurs vont dans le navigateur ; elles sont publiques par conception,
# les droits étant appliqués par la base (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# 0 : comportement de production (téléphone vide au départ, purge à la déconnexion).
NEXT_PUBLIC_DEMO=1

# Ne jamais mettre ici la clé secrète (sb_secret_… / service_role) : elle contourne toutes les règles d'accès.
